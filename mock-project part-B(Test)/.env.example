# ══════════════════════════════════════════════════════════════════
# Garage Boilerplate — the ONE env file
#
#   1. Copy to .env:        cp .env.example .env
#   2. Fill in the values below
#   3. Sync to packages:    pnpm run env:sync
#      (also runs automatically before `pnpm run dev`)
#
# frontend/.env.local and backend/.env are GENERATED from this file —
# never edit them by hand. Reference: docs/ENV-VARS.md
#
# There is no local emulator — the app always talks to the real Firebase
# project below. Create a free (Spark plan) Firebase project with Auth and
# Firestore enabled: https://console.firebase.google.com
# ══════════════════════════════════════════════════════════════════

# ── Firebase project ────────────────────────────────────────────────
# Your Firebase project id — must match .firebaserc → projects.default
# Named with the NEXT_PUBLIC_ prefix (like the rest of the web app config
# below) because this exact name is what frontend/.env.local, backend/.env,
# and Vercel's environment variables all use too — same name everywhere,
# nothing gets silently renamed in between.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Service account JSON, base64-encoded. SERVER-ONLY SECRET — never commit.
# Firebase Console → Project settings → Service accounts → Generate new private key
#   macOS (BSD base64):  base64 -i service-account.json | tr -d '\n'
#   Linux (GNU base64):  base64 -w 0 service-account.json
#   PowerShell:          [Convert]::ToBase64String([IO.File]::ReadAllBytes('C:\path\service-account.json'))
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=

# ── Firebase web app config ─────────────────────────────────────────
# Firebase Console → Project settings → Your apps → (your web app) → firebaseConfig
# These are safe for the browser — that's what the NEXT_PUBLIC_ prefix means.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — only if Google Analytics is enabled on the web app
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=

# ── Backend API ─────────────────────────────────────────────────────
# Allowed CORS origin for /api (empty = all cross-origin requests denied)
CORS_ORIGIN=
# Local port for the Functions API
PORT=5001

# ── Scheduled erasure job ───────────────────────────────────────────
# Server-only secret. Never give it a NEXT_PUBLIC_ prefix.
# The scheduled erasure route (/api/cron/erase-deleted-tasks) refuses every
# request while this is empty or unset.
# Rules: at least 16 characters, only ASCII letters (A-Z, a-z), digits and - _ . ~
# (for example the output of openssl rand -hex 32).
# Generate one (works on every OS):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or:
#   openssl rand -hex 32
# Set the same value in Vercel as an environment variable for the deployed
# app, because this root .env is for local development only.
CRON_SECRET=

# ── Claude Code MCP (optional) ──────────────────────────────────────
# Google Stitch design-to-code — https://stitch.withgoogle.com/settings
STITCH_API_KEY=

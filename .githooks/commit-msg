#!/bin/sh
# Enforce Conventional Commits (https://www.conventionalcommits.org/).
# Bypass with --no-verify if you really mean it (the server-side ruleset
# in .github/rulesets/ does not check commit message format, so this is
# on the honor system past this hook).

commit_msg_file="$1"
first_line=$(head -n 1 "$commit_msg_file")

pattern='^(feat|fix|docs|style|refactor|test|chore|build|ci|perf|revert)(\([a-zA-Z0-9._-]+\))?: .+'

if ! echo "$first_line" | grep -Eq "$pattern"; then
    echo "" >&2
    echo "Commit message does not follow Conventional Commits format." >&2
    echo "" >&2
    echo "Expected:" >&2
    echo "  <type>[(optional scope)]: <short summary>" >&2
    echo "" >&2
    echo "Allowed types: feat, fix, docs, style, refactor, test, chore, build, ci, perf, revert" >&2
    echo "" >&2
    echo "Examples (this repo is mostly documentation, so docs: is common):" >&2
    echo "  docs: add benchmarking findings for code review stage" >&2
    echo "  docs(research): fix broken link to lifecycle map export" >&2
    echo "" >&2
    echo "Your message was:" >&2
    echo "  $first_line" >&2
    echo "" >&2
    exit 1
fi

exit 0
